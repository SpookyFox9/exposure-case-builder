#!/bin/sh
# Secret scan on staged changes. Commit is blocked if gitleaks is missing or finds anything.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found; install it (winget install Gitleaks.Gitleaks). Commit blocked." >&2
  exit 1
fi
exec gitleaks git --staged --redact --no-banner -v
